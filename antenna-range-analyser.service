# Copy to /etc/systemd/system/ then: sudo systemctl enable --now antenna-range-analyser
[Unit]
Description=Antenna Range Analyser for ADS-B
After=network.target readsb.service

[Service]
User=pi
WorkingDirectory=/home/pi/antenna-range-analyser
ExecStart=/usr/bin/python3 /home/pi/antenna-range-analyser/run.py
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
